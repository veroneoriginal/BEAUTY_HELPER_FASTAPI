# Шаблон переменных окружения.
# Хосты заданы под docker-compose (имена сервисов). Для локального запуска


# --- Postgres ---
POSTGRES_DB=beauty_helper
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password_post
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=password_redis

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest2026
RABBITMQ_URL=amqp://guest:guest2026@rabbitmq:5672//

# Когда True, SQLAlchemy выводит в консоль все SQL-запросы
DEBUG=False

# --- JWT ---
# SECRET_KEY — длинная случайная строка. Сгенерировать: openssl rand -hex 32
SECRET_KEY=a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OpenAI ---
# Два аккаунта для ротации ключей (KeyManager). Можно указать один и тот же.
OPENAI_API_KEY_ACCOUNT_ONE=sk-...
OPENAI_API_KEY_ACCOUNT_TWO=sk-...
OPENAI_MODEL=gpt-4o-mini
# Курс USD→RUB для расчёта стоимости запросов (можно обновлять без правки кода)
OPENAI_USD_TO_RUB=79.89

# --- S3 ---
S3_ENDPOINT_URL=https://s3.example.com
S3_ACCESS_KEY_ID=your_id
S3_SECRET_KEY=your_key
S3_BUCKET_NAME=your_bucket_name
